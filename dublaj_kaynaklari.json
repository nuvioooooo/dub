          "from": "playerHtml",
          "group": 1,
          "patterns": [
            "_p8\\s*=\\s*['\"]([^'\"]+)['\"]",
            "\\bav\\('([^']+)'\\)"
          ]
        },
        {
          "op": "reverse"
        },
        {
          "op": "base64",
          "charset": "latin1"
        },
        {
          "op": "shift_key",
          "key": "K9L",
          "mod": 5,
          "add": 1,
          "dir": "sub"
        },
